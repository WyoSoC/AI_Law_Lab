# Copy to .env and adjust. All settings are also overridable as environment variables.

# --- inference tier ---------------------------------------------------------
# Tailscale hostnames of the DGX Spark units. The lab-subnet addresses
# (10.99.252.31/.32) are NOT routable from the orchestrator -- do not use them.
AILAWLAB_SPARK_HOSTS=["test-spark3","test-spark4"]
AILAWLAB_CHAT_MODEL=gemma4:latest
AILAWLAB_EMBED_MODEL=nomic-embed-text:latest

# Concurrent model calls admitted per host. Measured ceiling is ~16; beyond that
# throughput is flat and only latency grows. Re-measure with scripts/bench_sparks.py
# after any hardware or Ollama change.
AILAWLAB_SLOTS_PER_HOST=16

# --- storage ----------------------------------------------------------------
AILAWLAB_DATABASE_URL=postgresql://ailawlab:ailawlab@127.0.0.1:5433/ailawlab
POSTGRES_PASSWORD=ailawlab

# --- web --------------------------------------------------------------------
AILAWLAB_HOST=0.0.0.0
AILAWLAB_PORT=8088

# Subpath the app is mounted at behind a reverse proxy; empty means it owns the root.
# The deployment on datahive.uwyo.edu uses /ai_law_lab. Must match the proxy's path.
AILAWLAB_URL_PREFIX=

# --- online legal sources ---------------------------------------------------
# All optional. CourtListener search, the Federal Register and the eCFR need no keys.
AILAWLAB_COURTLISTENER_TOKEN=      # courtlistener.com/profile/api — full opinion text
AILAWLAB_GOVINFO_API_KEY=          # api.data.gov/signup — US Code, Public Laws, bills
AILAWLAB_SEC_USER_AGENT=AI Law Lab (University of Wyoming) you@example.edu

# --- roleplay ---------------------------------------------------------------
AILAWLAB_DEFAULT_MAX_TURNS=100     # starting max_turns in the experiment builder
AILAWLAB_MAX_TURNS_LIMIT=100       # hard cap the builder will accept
AILAWLAB_DEFAULT_WORD_LIMIT=1000   # starting words-per-turn in the experiment builder
AILAWLAB_WORD_LIMIT_MAX=2000       # hard cap on words per turn
