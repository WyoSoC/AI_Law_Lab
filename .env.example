# Copy to .env and adjust. All settings are also overridable as environment variables.

# --- inference tier ---------------------------------------------------------
# Tailscale hostnames of the DGX Spark units. The lab-subnet addresses
# (10.99.252.31/.32) are NOT routable from the orchestrator -- do not use them.
AILAWLAB_SPARK_HOSTS=["test-spark3","test-spark4"]
AILAWLAB_CHAT_MODEL=gemma4:latest
AILAWLAB_EMBED_MODEL=nomic-embed-text:latest

# Concurrent model calls admitted per host. Measured ceiling is ~16; beyond that
# throughput is flat and only latency grows. Re-measure with scripts/bench_sparks.py
# after any hardware or Ollama change.
AILAWLAB_SLOTS_PER_HOST=16

# --- storage ----------------------------------------------------------------
AILAWLAB_DATABASE_URL=postgresql://ailawlab:ailawlab@127.0.0.1:5433/ailawlab
POSTGRES_PASSWORD=ailawlab

# --- web --------------------------------------------------------------------
AILAWLAB_HOST=0.0.0.0
AILAWLAB_PORT=8088
